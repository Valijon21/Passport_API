# ─── OCR ID System — Environment Variables ────────────────────────────────
# Nusxa oling: cp .env.example .env

# Django
SECRET_KEY=your-secret-key-change-this-to-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (production da frontend URL ni yozing)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# Tesseract (Windows da: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=/usr/bin/tesseract
